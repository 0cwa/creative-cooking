async function freePort():Promise<number>{
 return new Promise((resolve,reject)=>{
  const s=net.createServer();s.once('error',reject);
  s.listen(0,'127.0.0.1',()=>{
   const addr=s.address();if(!addr||typeof addr==='string')return reject(Error('no port'));
   s.close(()=>resolve(addr.port));
  });
 });
}
async function waitPort(port:number,child:ChildProcess,log:()=>string){
 for(let n=0;n<250;n++){
  if(child.exitCode!==null||child.signalCode!==null)throw Error('Exited before listener: '+log().slice(-3000));
  try {await new Promise<void>((resolve,reject)=>{
   const s=net.connect(port,'127.0.0.1');
   s.once('connect',()=>{s.destroy();resolve();});
   s.once('error',reject);s.setTimeout(250,()=>{s.destroy();reject(Error('tcp timeout'));});
  });return;}catch{await delay(100);}
 }
 throw Error('Listener did not start: '+log().slice(-3000));
}
async function terminate(child:ChildProcess|null,signal:NodeJS.Signals='SIGTERM'){
 if(!child || child.exitCode!==null||child.signalCode!==null)return;
 await new Promise<void>(resolve=>{
  const watchdog=setTimeout(()=>{if(child.exitCode===null && child.signalCode===null)child.kill('SIGKILL');},4500);
  child.once('exit',()=>{clearTimeout(watchdog);resolve();});
  child.kill(signal);
 });
}
function sample(pid:number|undefined){
 if(!pid)return null;
 try{
  const status=readFileSync('/proc/'+pid+'/status','utf8');
  const rss=Number(/VmRSS:\s+(\d+)/.exec(status)?.[1] || 0);
  const hwm=Number(/VmHWM:\s+(\d+)/.exec(status)?.[1] || 0);
  const threads=Number(/Threads:\s+(\d+)/.exec(status)?.[1] || 0);
  const fields=execFileSync('ps',['-p',String(pid),'-o','%cpu=,rss='],{encoding:'utf8'}).trim().split(/\s+/);
  return {rssKiB:rss,peakRssKiB:hwm,threads,cpuPercentSnapshot:Number(fields[0]||0),psRssKiB:Number(fields[1]||0)};
 }catch(error){return {samplingError:String(error)};}
}
async function httpsProbe(port:number,path:string,method='GET',origin?:string,body?:Buffer){
 return new Promise<any>((resolve,reject)=>{
  const headers:Record<string,string>={};if(origin)headers.Origin=origin;
  if(body)headers['Content-Length']=String(body.length);
  const req=https.request({hostname:'127.0.0.1',port,path,method,rejectUnauthorized:false,headers,timeout:7000},res=>{
   const bytes:Buffer[]=[];res.on('data',b=>bytes.push(b));
   res.on('end',()=>resolve({status:res.statusCode,headers:res.headers,body:Buffer.concat(bytes).toString().slice(0,600)}));
  });
  req.once('error',reject);req.once('timeout',()=>req.destroy(Error('HTTPS probe timeout')));
  if(body)req.end(body);else req.end();
 });
}
// A real TLS handshake with a browser-like WebSocket upgrade, but a foreign
// Origin. No authentication is implied by a 403 Origin response.
async function forbiddenWsOrigin(port:number):Promise<string>{
 return new Promise((resolve,reject)=>{
  const client=tls.connect({host:'127.0.0.1',port,rejectUnauthorized:false},()=>{
   client.write([
    'GET / HTTP/1.1','Host: 127.0.0.1:'+port,'Upgrade: websocket',
    'Connection: Upgrade','Sec-WebSocket-Version: 13',
    'Sec-WebSocket-Key: '+Buffer.alloc(16,0x53).toString('base64'),
    'Origin: https://attacker.invalid','',''
   ].join('\r\n'));
  });
  client.setTimeout(5000,()=>client.destroy(new Error('Origin-test handshake timed out')));
  client.once('data',value=>{resolve(value.toString().split('\r\n')[0]);client.end();});
  client.once('error',reject);
 });
}
async function stats(port:number){

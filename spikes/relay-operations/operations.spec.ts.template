async function pagePeer(browser:any,port:number,proxyPort:number,opts:{lp?:boolean;old?:boolean;direct?:boolean}={}){
 const context=await browser.newContext({ignoreHTTPSErrors:true});
 const page=await context.newPage();
 await page.goto(opts.old ? 'http://127.0.0.1:9892/' : 'http://127.0.0.1:9891/');
 await page.waitForFunction(()=>(window as any).subductionReady===true,{timeout:45000});
 const service='creative-cooking-local-ops-v1';
 await page.evaluate(async ({ws,http,service,lp}:any)=>{
  const api=(window as any).subduction,signer=await api.WebCryptoSigner.setup();
  const syncer=new api.Subduction({signer,storage:new api.MemoryStorage()});
  const link=lp?await syncer.connectDiscoverLongPoll(http,service):
   await syncer.connectDiscover(new URL(ws),service);
  (window as any).ops={syncer,link,sid:api.SedimentreeId.fromBytes(new Uint8Array(32).fill(73))};
 },{ws:opts.direct?'ws://127.0.0.1:'+port:'wss://127.0.0.1:'+proxyPort,
     http:'https://127.0.0.1:'+proxyPort,service,lp:!!opts.lp});
 return {context,page};
}
async function disconnect(page:any){
 await page.evaluate(async()=>(window as any).ops.syncer.disconnectAll());
}
async function reconnect(page:any,port:number,proxyPort:number,lp=false){
 await page.evaluate(async({ws,http,service,lp}:any)=>{
  const t=(window as any).ops;t.link=lp?
   await t.syncer.connectDiscoverLongPoll(http,service):
   await t.syncer.connectDiscover(new URL(ws),service);
 },{ws:'wss://127.0.0.1:'+proxyPort,http:'https://127.0.0.1:'+proxyPort,
    service:'creative-cooking-local-ops-v1',lp});
}
async function push(page:any,commit:Item){
 return page.evaluate(async({id,deps,data}:any)=>{
  const api=(window as any).subduction,t=(window as any).ops;
  await t.syncer.addCommit(t.sid,new api.CommitId(new Uint8Array(id)),
   deps.map((x:number[])=>new api.CommitId(new Uint8Array(x))),new Uint8Array(data));
  const result=await t.syncer.syncWithPeer(t.link,t.sid,true,15000);
  return {success:result.success,sent:result.stats.commitsSent,received:result.stats.commitsReceived};
 },{id:[...Buffer.from(commit.id,'hex')],
    deps:commit.dependencies.map(h=>[...Buffer.from(h,'hex')]),
    data:[...Buffer.from(commit.ciphertextBase64,'base64')]});
}
async function pull(page:any){
 return page.evaluate(async()=>{
  const t=(window as any).ops, r=await t.syncer.syncWithPeer(t.link,t.sid,true,15000);
  const all=await t.syncer.getCommits(t.sid);
  return {success:r.success,received:r.stats.commitsReceived,sent:r.stats.commitsSent,count:all?.length||0};
 });
}
async function eventually(page:any,n:number){
 const stop=Date.now()+25000;let last:any;
 while(Date.now()<stop){
  last=await pull(page);
  if(last.success && last.count===n)return last;
  if(last.count>n)throw Error('unexpected surplus changes: '+JSON.stringify(last));
  await delay(150);
 }
 throw Error('late peer failed to catch up: '+JSON.stringify({expected:n,last}));
}
async function blobBase64(page:any){
 const bytes:number[][]=await page.evaluate(async()=>{
  const t=(window as any).ops;
  return (await t.syncer.getBlobs(t.sid)).map((b:Uint8Array)=>Array.from(b));
 });
 return bytes.map(x=>Buffer.from(x).toString('base64'));
}
function verifyExact(base64:string[],len=fixture.commits.length){
 expect(base64.length).toBe(len);
 const actual=new Set(base64.map(v=>sha(Buffer.from(v,'base64'))));
 for(const item of fixture.commits.slice(0,len)) expect(actual.has(item.ciphertextSha256),item.label).toBe(true);
}
function verifyEngine(full:string[],root:string){
 const path=join(root,'received.json');writeFileSync(path,JSON.stringify(full));
 const result=execFileSync(process.execPath,[fixtureScript,'verify',fixturePath,path],{encoding:'utf8',timeout:120000});
 return JSON.parse(result.trim().split('\n').at(-1)!);
}
function byteCount(root:string,store:any){
 return store.files(root).reduce((sum:number,f:string)=>sum+statSync(join(root,f)).size,0);
}
async function safeTry(label:string,fn:()=>Promise<unknown>|unknown){
 try{
  const value=await fn();
  // A skipped test is never represented as a PASS merely because the
  // capability/availability probe returned successfully.
  if(value && typeof value==='object' && 'status' in value &&
     ['NOT_TESTED','SIMULATED_ONLY','PROBED_HOST_ONLY','PARTIAL','OBSERVED_UNDURABLE_SYNC_RESULT'].includes(String((value as any).status)))
   return {status:(value as any).status,value};
  return {status:'PASS',value};
 }
 catch(error){return {status:'FAIL',label,error:String(error)};}
}


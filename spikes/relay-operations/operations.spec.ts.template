  await boot(cli,orphanDir);
  const orphanPeer=await tracked();
  const orphanRead=await eventually(orphanPeer.page,fixture.commits.length);
  verifyExact(await blobBase64(orphanPeer.page));
  await stop();
  evidence.actualChecks.interruptedBlobWrite={status:'SIMULATED_ONLY',
    observed:'extra unreferenced .tmp file did not prevent real Rust redb+blob restart',
    freshPeerRecovered:orphanRead.count,allCiphertextExact:true,
    unproven:'actual kill point between fsync of external blob and redb commit'};
  await boot(cli,restored);
  const unavailable=await safeTry('unavailable service',async()=>{
   await stop('SIGKILL');
   const probe=await httpsProbe(proxyPort,'/unavailable','GET','http://127.0.0.1:9891');
   expect(probe.status).toBe(502);
   const backoffProbe:any[]=[];
   for(const milliseconds of [100,200,400]){
    const started=Date.now();
    const again=await httpsProbe(proxyPort,'/unavailable','GET','http://127.0.0.1:9891');
    expect(again.status).toBe(502);
    backoffProbe.push({status:again.status,scheduledBackoffMs:milliseconds,
      elapsedProbeMs:Date.now()-started});
    await delay(milliseconds);
   }
   await boot(cli,restored);
   // /unavailable is an intentionally invalid protocol path. The actual
   // upstream can respond 502 even when healthy, so its HTTP status is NOT
   // an availability check. A fresh authenticated-protocol sync round-trip
   // is the recovery oracle, not an unrelated GET.
   const available=await httpsProbe(proxyPort,'/unavailable','GET','http://127.0.0.1:9891');
   const returned=await tracked();const result=await eventually(returned.page,fixture.commits.length);
   expect(result.success).toBe(true);
   return {downstreamStatus:probe.status,returningPeerCount:result.count,
     proxyHttpRetryProbe:backoffProbe,invalidPathStatusAfterRestart:available.status,
     actualProtocolRecovered:true,
     qualification:'Bounded HTTP probe backoff; invalid-path status does not prove availability. Fresh real WASM/Subduction sync does. No production browser/native SDK retry proof.',
     recommendedClientBackoffMs:[250,500,1000,2000,4000,8000]};
  });
  evidence.actualChecks.unavailableAndRecover=unavailable;
  evidence.actualChecks.quotas={status:'PARTIAL',proxyOnlyHttpBytes:262144,upstreamWsMaxMessageSize:131072,
    proxySimultaneousWsLimit:16,testedHttp413:true,
    unproven:'authentication, per-household byte quota, rate limiting of WS frames, public adversarial DoS'};
  evidence.actualChecks.diskFull=await safeTry('real Subduction writer under private bounded tmpfs ENOSPC',async()=>{
   // An isolated, 12 MiB mounted tmpfs, NOT the runner's potentially huge
   // /dev/shm. Requires noninteractive sudo mount on the disposable CI host.
   // A rejected mount returns NOT_TESTED and does not touch runner root storage.
   const mountPoint=join(root,'ops-limited-volume');
   mkdirSync(mountPoint,{recursive:true,mode:0o700});
   try{
    execFileSync('sudo',['-n','mount','-t','tmpfs','-o','size=12m,nodev,nosuid,mode=1777','tmpfs',mountPoint],
     {encoding:'utf8',timeout:12000,stdio:'pipe'});
   }catch(e:any){
    return {status:'NOT_TESTED',reason:'Private bounded tmpfs mount unavailable, avoiding unsafe whole-host pressure',
      mountError:String(e?.stderr||e).slice(0,250)};
   }
   const fs=await import('node:fs');
   const diskDir=join(mountPoint,'real-rust-data'),filler=join(mountPoint,'bounded-filler');
   let kernelErrno='',attempted:any={notAttempted:true},initial:any=null;
   let restarted:any=null,recoveredCount=0,recoveredExact=false,filledBytes=0;
   let serverFailureObserved=false,availableBeforeBytes=0;
   try{
    // Quiesce the other test store before moving the only Rust listener.
    await stop();
    mkdirSync(diskDir,{recursive:true,mode:0o700});
    writeFileSync(join(diskDir,'identity.key'),randomBytes(32).toString('hex')+'\n',{mode:0o600});
    await boot(cli,diskDir);
    const writer=await tracked({direct:true});
    const independent=await tracked({direct:true});
    const first=await push(writer.page,fixture.commits[0]);expect(first.success).toBe(true);
    initial=await eventually(independent.page,1);
    verifyExact(await blobBase64(independent.page),1);
    const statfs=fs.statfsSync(mountPoint);
    availableBeforeBytes=Number(statfs.bavail)*Number(statfs.bsize);
    // Fill only this private 12 MiB volume, not /dev/shm or runner disk.
    const fd=fs.openSync(filler,'w');
    try{
     const chunk=Buffer.alloc(128*1024,0x5c);
     for(let i=0;i<256;i++){
      try{
       const n=fs.writeSync(fd,chunk);filledBytes+=n;
       if(n===0)throw Error('zero-byte tmpfs write');
      }catch(e:any){kernelErrno=String(e?.code||e);break;}
     }
    }finally{fs.closeSync(fd);}
    expect(kernelErrno,'must reach real tmpfs ENOSPC before testing relay').toBe('ENOSPC');
    const logBefore=relayLog.length;
    try{attempted={returned:await push(writer.page,fixture.commits[1])};}
    catch(e){attempted={error:String(e).slice(0,350)};}
    const redbWriteLog=relayLog.slice(logBefore);
    serverFailureObserved=/ENOSPC|No space left|database full|storage failed|io error/i.test(redbWriteLog)
      || attempted.returned?.success===false || !!attempted.error;
    await stop('SIGKILL');
    fs.rmSync(filler,{force:true});
    await boot(cli,diskDir);
    const fresh=await tracked({direct:true});
    const deadline=Date.now()+20000;let last:any;
    while(Date.now()<deadline){
     last=await pull(fresh.page);
     if(last.success && last.count>=1)break;
     await delay(160);
    }
    expect(last?.success).toBe(true);
    expect([1,2]).toContain(last?.count);
    const exact=await blobBase64(fresh.page);
    verifyExact(exact,last.count);
    recoveredCount=last.count;recoveredExact=true;restarted=last;
    const apparentSyncButMissingCommit=attempted.returned?.success===true && recoveredCount===1;
    // The original client still retains the second local update even if the
    // server did not. Test independent late-peer catch-up after original replay,
    // rather than silently calling transport-level 'success' a durable ack.
    let retransmission:any={status:'NOT_NEEDED',reason:'server already contains both updates'};
    if(recoveredCount===1){
     retransmission=await safeTry('replay missing change from the originating client',async()=>{
      await reconnect(writer.page,relayPort,proxyPort);
      const retry=await pull(writer.page);
      const late=await eventually(fresh.page,2);
      verifyExact(await blobBase64(fresh.page),2);
      return {retry,late,exactCiphertext:true};
     });
    }
    return {
     status:apparentSyncButMissingCommit?'OBSERVED_UNDURABLE_SYNC_RESULT':
      serverFailureObserved?'PASS':'PROBED_HOST_ONLY',
     mount:'isolated 12MiB private tmpfs; no rootfs pressure',kernelErrno,
     filledBytes,availableBeforeBytes,initialPersisted:first.success && initial.count===1,
     attemptedWhileFull:attempted,serverErrorOrRejectedSyncObserved:serverFailureObserved,
     recoveredAfterKill:restarted,recoveredCount,recoveredExact,
     transportSuccessWithoutDurableCommit:apparentSyncButMissingCommit,
     replayFromOriginalPeer:retransmission,
     qualification:apparentSyncButMissingCommit
      ? 'The client sync API reported success but update 2 was absent after crash; this was not a verified durable acknowledgment. A surviving peer must retain and replay missing history.'
      : serverFailureObserved
       ? 'Rust write error/rejected sync observed during ENOSPC; baseline update survived restart.'
       : 'ENOSPC observed on server filesystem, but durable result of stressed update did not show a rejection.'};
   }finally{
    await stop().catch(()=>{});
    fs.rmSync(filler,{force:true});
    // No mounted filesystem survives the disposable test process.
    try{execFileSync('sudo',['-n','umount',mountPoint],{timeout:12000,stdio:'pipe'});}
    finally{rmSync(mountPoint,{recursive:true,force:true});}
   }
  });
  // This tests a REAL older/newer binary pair, while keeping incompatible
  // cases as evidence rather than declaring unsupported wire semantics PASS.
  // Check both ends of each upgrade pair with an independent receiver, not
  // the local document that the writer already added to its own MemoryStorage.
  // A successful local addCommit() is NOT evidence the old Rust server persisted.
  const upgrade:any={
   status:previousCli?'TESTED_PARTIAL_RESULT_SEE_CASES':'NOT_TESTED',
   pair:'v0.18.0 -> v0.19.0',newWasmClientOldServer:{status:'NOT_TESTED'},
   sameBinaryDurability:{status:'NOT_TESTED'},oldToNew:{status:'NOT_TESTED'},
   newWritesAfterUpgrade:{status:'NOT_TESTED'},downgradeSameData:{status:'NOT_TESTED'},
   rollbackFromQuiescentOldSnapshot:{status:'NOT_TESTED'},oldWasmClientNewServer:{status:'NOT_TESTED'},
   qualification:'Every successful recovery uses an independent fresh browser, exact ciphertext and a pinned server binary.'
  };
  if(previousCli){
   await stop();
   const upgrDir=join(root,'upgrade'),upBackup=join(root,'upgrade-backup');
   mkdirSync(upgrDir,{recursive:true});
   writeFileSync(join(upgrDir,'identity.key'),randomBytes(32).toString('hex')+'\n',{mode:0o600});
   upgrade.newWasmClientOldServer=await safeTry('new WASM -> old Rust; second client must see bytes',async()=>{
    await boot(previousCli,upgrDir);
    const writer=await tracked({direct:true});
    const pushed=await push(writer.page,fixture.commits[0]);expect(pushed.success).toBe(true);
    const independent=await tracked({direct:true});
    const recovered=await eventually(independent.page,1);
    verifyExact(await blobBase64(independent.page),1);
    await disconnect(writer.page);
    return {pushed,recovered,exactCiphertext:true};
   });
   await stop();
   if(upgrade.newWasmClientOldServer.status==='PASS' && existsSync(join(upgrDir,'sedimentree.redb'))){
    upgrade.sameBinaryDurability=await safeTry('old Rust own restart durability',async()=>{
     await boot(previousCli,upgrDir);
     const fresh=await tracked({direct:true});
     const result=await eventually(fresh.page,1);
     verifyExact(await blobBase64(fresh.page),1);
     return {result,verifiedAfterOldServerRestart:true};
    });
    await stop();
   } else upgrade.sameBinaryDurability={
    status:'BLOCKED_BY_PRECONDITION',
    reason:'No independently verified old-client/new-WASM -> old-server persisted change; do not call subsequent update loss an upgrade regression.'
   };
   if(upgrade.sameBinaryDurability.status==='PASS'){
    store.snapshot(upgrDir,upBackup,{serverStopped:true});
    upgrade.oldToNew=await safeTry('0.18 persisted store -> 0.19 binary',async()=>{
     await boot(cli,upgrDir);
     const fresh=await tracked({direct:true});
     const result=await eventually(fresh.page,1);
     verifyExact(await blobBase64(fresh.page),1);
     return {result,exactCiphertext:true};
    });
    await stop();
    if(upgrade.oldToNew.status==='PASS'){
     upgrade.newWritesAfterUpgrade=await safeTry('new version writes after recovering old store',async()=>{
      await boot(cli,upgrDir);
      const writer=await tracked({direct:true});
      await eventually(writer.page,1);
      const pushed=await push(writer.page,fixture.commits[1]);expect(pushed.success).toBe(true);
      const fresh=await tracked({direct:true});
      const result=await eventually(fresh.page,2);
      verifyExact(await blobBase64(fresh.page),2);
      await disconnect(writer.page);
      return {pushed,result,exactCiphertext:true};
     });
     await stop();
    }else upgrade.newWritesAfterUpgrade={
     status:'BLOCKED_BY_PRECONDITION',reason:'0.19 failed recovery of independently proven 0.18 store'
    };
    if(upgrade.newWritesAfterUpgrade.status==='PASS'){
     upgrade.downgradeSameData=await safeTry('0.19-written live store -> old 0.18 binary',async()=>{
      await boot(previousCli,upgrDir);
      const fresh=await tracked({direct:true});
      const result=await eventually(fresh.page,2);
      verifyExact(await blobBase64(fresh.page),2);
      return {result,exactCiphertext:true,
       caution:'In-place downgrade may be lossy despite protocol success; compare underlying store bytes separately.'};
     });
     await stop();
    }else upgrade.downgradeSameData={
     status:'BLOCKED_BY_PRECONDITION',reason:'No verified post-upgrade write, so in-place downgrade not interpretable'
    };
    const rollback=join(root,'rollback-restored');
    store.restore(upBackup,rollback,{serverStopped:true});
    upgrade.rollbackFromQuiescentOldSnapshot=await safeTry('old 0.18 from pre-upgrade snapshot',async()=>{
     await boot(previousCli,rollback);
     const fresh=await tracked({direct:true});
     const result=await eventually(fresh.page,1);
     verifyExact(await blobBase64(fresh.page),1);
     return {result,exactCiphertext:true,
      qualification:'Rollback restores only pre-upgrade state; any later writes are lost unless explicitly replayed.'};
    });
    await stop();
   }else{
    upgrade.oldToNew={status:'BLOCKED_BY_PRECONDITION',reason:'0.18.0 baseline byte durability not proven'};
    upgrade.newWritesAfterUpgrade={status:'BLOCKED_BY_PRECONDITION'};
    upgrade.downgradeSameData={status:'BLOCKED_BY_PRECONDITION'};
    upgrade.rollbackFromQuiescentOldSnapshot={status:'BLOCKED_BY_PRECONDITION'};
   }
   // Independent old-client/new-server test: create and confirm history on an
   // 0.19 server first. Do not silently rely on the possibly empty 0.18 store.
   if(process.env.CC_OPS_OLD_STATIC_URL){
    const crossDir=join(root,'old-wasm-new-server');
    mkdirSync(crossDir,{recursive:true});
    writeFileSync(join(crossDir,'identity.key'),randomBytes(32).toString('hex')+'\n',{mode:0o600});
    upgrade.oldWasmClientNewServer=await safeTry('real 0.18 WASM -> proven 0.19 server history',async()=>{
     await boot(cli,crossDir);
     const writer=await tracked({direct:true});
     const pushed=await push(writer.page,fixture.commits[0]);expect(pushed.success).toBe(true);
     const modern=await tracked({direct:true});
     const baseline=await eventually(modern.page,1);
     verifyExact(await blobBase64(modern.page),1);
     await disconnect(writer.page);
     const oldBrowser=await tracked({old:true,direct:true});
     const result=await eventually(oldBrowser.page,1);
     verifyExact(await blobBase64(oldBrowser.page),1);
     return {pushed,modernBaseline:baseline,oldWasmRecovery:result,exactCiphertext:true};
    });
    await stop();
   }else upgrade.oldWasmClientNewServer={status:'NOT_TESTED',reason:'older pinned WASM test page did not build'};
  }
  evidence.actualChecks.versionedUpgradeRollback=upgrade;
  evidence.observations.finalProxyStats=await stats(proxyPort);
  evidence.actualChecks.signerContinuity={status:'PASS',uniqueSeedCount:peerIdBySeed.size,
   checkedLaunches:launches,allExistingSeedRestartsMatched:true,
   qualification:'Public Ed25519 peer IDs remain stable for the same seed; this does not prove real client pinning or trust rotation.'};
  evidence.actualChecks.staticPwaHosting={status:'ARCHITECTURAL',finding:'GitHub Pages stays static; persistent server, storage, DNS/TLS, keys, backups external'};
  expect(evidence.actualChecks.proxyOrigin.status).toBe('PASS');
  expect(evidence.actualChecks.unavailableAndRecover.status).toBe('PASS');
 } catch(error){
  evidence.fatal={error:String(error),relayLogTail:relayLog.slice(-4000),proxyLogTail:proxyLog.slice(-2000)};
  throw error;
 } finally{
  await stop().catch(()=>{});
  await terminate(proxy).catch(()=>{});
  for(const c of children)await c.context.close().catch(()=>{});
  const resultFile=join(output,'relay-operations-result.json');
  writeFileSync(resultFile,JSON.stringify(evidence,null,2));
  await testInfo.attach('relay-operations-result.json',{body:JSON.stringify(evidence,null,2),contentType:'application/json'});
  console.log('CC_RELAY_OPERATIONS_RESULT='+JSON.stringify({
   fatal:!!evidence.fatal,checks:Object.fromEntries(Object.entries(evidence.actualChecks).map(([k,v]:any)=>[k,v.status])),
   outputs:resultFile
  }));
  rmSync(root,{recursive:true,force:true});
 }

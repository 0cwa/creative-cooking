# Copy to .env for local development. Replace both values with random secrets.
DATABASE_URL=postgres://creative_cooking:replace-me@127.0.0.1:55439/creative_cooking
TEST_DATABASE_URL=postgres://creative_cooking:replace-me@127.0.0.1:55439/creative_cooking_test
SESSION_TOKEN_PEPPER=replace-with-at-least-32-random-bytes
POSTGRES_PASSWORD=replace-me
POWERSYNC_REPLICATION_PASSWORD=replace-with-at-least-32-random-bytes
POWERSYNC_STORAGE_PASSWORD=replace-with-at-least-32-random-bytes
SYNC_JWT_PRIVATE_KEY_B64URL=replace-with-base64url-encoded-ed25519-private-pem
SYNC_JWT_PUBLIC_KEY_B64URL=replace-with-base64url-encoded-ed25519-public-pem
SYNC_JWT_KEY_ID=creative-cooking-local-v1
SYNC_JWT_AUDIENCE=creative-cooking-sync
SYNC_JWT_ISSUER=creative-cooking-api
API_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

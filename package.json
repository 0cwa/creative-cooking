{
  "name": "creative-cooking",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --experimental-strip-types --test src/domain/*.test.mjs src/chef/*.test.mjs src/storage/*.test.mjs src/llm/*.test.mjs src/llm/openrouter/*.test.mjs src/llm/webllm/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export -p web",
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "check": "npm run test && npm run typecheck && EXPO_PUBLIC_BASE_URL=/creative-cooking npm run build:web && npm run verify:pwa",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "expo": "~57.0.17",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-sharing": "~57.0.21",
    "expo-clipboard": "~57.0.2",
    "@mlc-ai/web-llm": "0.2.82"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "@playwright/test": "1.55.0"
  }
}
